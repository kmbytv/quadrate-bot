# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Google Service Account credentials as a single-line JSON string
# Paste the entire contents of your credentials.json here (no newlines)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Sheets spreadsheet ID (from the URL: /spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Telegram chat_id of the director to notify
DIRECTOR_CHAT_ID=123456789

# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
WHITELIST_IDS=111111111,222222222
