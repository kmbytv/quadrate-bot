# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Airtable Personal Access Token
# Получить: https://airtable.com/create/tokens → New Token → Scopes: data.records:write
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Airtable Base ID (из URL базы: https://airtable.com/appXXXXXXXXXXXXXX/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Название таблицы внутри базы (по умолчанию "Возвраты")
AIRTABLE_TABLE_NAME=Возвраты

# Telegram chat_id директора для уведомлений
DIRECTOR_CHAT_ID=123456789

# Comma-separated список разрешённых Telegram user ID (оставь пустым — доступ для всех)
WHITELIST_IDS=111111111,222222222
